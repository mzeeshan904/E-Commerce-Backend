# DB via DSN
DATABASE_URL="postgresql://postgres:12345@localhost:5432/e-commerce-db?schema=public"

# App
NODE_ENV=development
PORT=3000
API_PREFIX=app/v1

# (Optional) If you still want discrete fields to match the DSN:
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=12345
DATABASE_NAME=e-commerce-db
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=true

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# REQUIRED — add strong secrets (≥32 chars)
JWT_SECRET=superlongsuperlongsuperlongsuperlong
JWT_REFRESH_SECRET=superlongsuperlongsuperlongsuperlong
